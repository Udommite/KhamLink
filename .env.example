# Safe local defaults. Do not put secrets in frontend variables.
# Non-editable deployments must export KHAMLINK_PROJECT_ROOT before Python starts.
# Docker supplies /app; editable workspace installations resolve their root automatically.
KHAMLINK_ENVIRONMENT=local
KHAMLINK_DATABASE_URL=sqlite:///data/khamlink.db
KHAMLINK_PROVIDER=extractive
KHAMLINK_SEMANTIC_ENABLED=true
KHAMLINK_EMBEDDING=bge-m3
KHAMLINK_QUERY_LIMIT=300
KHAMLINK_CONTEXT_LIMIT=3000
KHAMLINK_REPORT_LIMIT=1000
KHAMLINK_PAGE_LIMIT=20
KHAMLINK_MAP_LIMIT=16
KHAMLINK_BODY_LIMIT=65536
KHAMLINK_LOOKUP_RATE=240
KHAMLINK_COSTLY_RATE=40
KHAMLINK_FEEDBACK_RATE=20
KHAMLINK_ANALYTICS_ENABLED=false
KHAMLINK_RETENTION_DAYS=7
KHAMLINK_CACHE_TTL=120
KHAMLINK_CACHE_SIZE=512
KHAMLINK_PROVIDER_TIMEOUT=8
KHAMLINK_IDENTITIES_JSON={}
# Optional self-hosted/approved compatible endpoint; disabled until explicitly configured.
KHAMLINK_PROVIDER_URL=
KHAMLINK_PROVIDER_MODEL=
KHAMLINK_PROVIDER_KEY=
# --- BGE-M3 retrieval (default) ---
# Directory holding senses.parquet, relations.parquet and embeddings.parquet.
# The corpus is licensed and is NOT downloaded; the operator supplies it.
KHAMLINK_CORPUS_DIR=data/corpus
KHAMLINK_BGE_MODEL=BAAI/bge-m3
KHAMLINK_RERANK_MODEL=BAAI/bge-reranker-v2-m3
KHAMLINK_RERANK_ENABLED=true
KHAMLINK_RERANK_CANDIDATES=50
# Cross-encoder logits go negative when nothing in the corpus genuinely matches; a query
# whose best candidate falls below this returns "no reliable result" instead of noise.
KHAMLINK_RERANK_FLOOR=0.0
# score += weight * log10(1 + Thai National Corpus count). 0 disables the commonness prior.
KHAMLINK_FREQUENCY_WEIGHT=0.6
# LLM query expansion (HyDE). Off by default: it sends the reader's words to the provider
# configured above, costs money per search, and is slower. Needs PROVIDER_URL + MODEL.
KHAMLINK_QUERY_EXPANSION=false
KHAMLINK_EXPANSION_MIN_LENGTH=12

# Neural embedding is opt-in. Pin a model's 40-character revision and verify its license first.
KHAMLINK_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KHAMLINK_EMBEDDING_REVISION=
KHAMLINK_SYNONYM_ENABLED=false
KHAMLINK_SYNONYM_THRESHOLD=0.92
KHAMLINK_RECOGNITION_THRESHOLD=0.26
KHAMLINK_SEMANTIC_THRESHOLD=0.18
KHAMLINK_LEXICAL_WEIGHT=0.35
KHAMLINK_DENSE_WEIGHT=0.30
KHAMLINK_GRAPH_WEIGHT=0.20
KHAMLINK_METADATA_WEIGHT=0.05
KHAMLINK_CONTEXT_WEIGHT=0.10
KHAMLINK_PPR_DAMPING=0.5
KHAMLINK_PASSAGE_SEED_WEIGHT=0.05
KHAMLINK_SENSE_MARGIN=0.12
KHAMLINK_PRODUCTION_POLICY_ACK=false
# KHAMLINK_DATA_DIR and KHAMLINK_SOURCE_MANIFEST accept absolute paths; defaults are workspace paths.
# KHAMLINK_ADMIN_TOKEN is a server-side process environment variable used only by protected CLI jobs.
# KHAMLINK_LIVE_TESTS=1 is required for explicit external-provider tests.
